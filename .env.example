# Google Gemini API key for label OCR (Vision).
# Free tier: https://aistudio.google.com/apikey
# Without it, presets and manual ingredient entry still work; only camera
# and photo-upload scanning is unavailable.
GEMINI_API_KEY=

# Optional. Overrides the default Gemini model used for extraction.
# Google retires models on a rolling basis; the route falls back through
# gemini-3.5-flash -> gemini-flash-latest -> gemini-3-flash-preview.
# GEMINI_MODEL=gemini-3.5-flash

# Optional additional keys for rotation. Gemini meters the free tier per
# project per model per day, so a key on a second project is a second
# allowance. GEMINI_API_KEY_1 .. GEMINI_API_KEY_9 are tried in order when the
# previous key is rejected or out of quota.
# GEMINI_API_KEY_1=

# Optional. Wall-clock budget in ms for the whole extraction, across every
# key and model. Defaults to 45000.
# OCR_BUDGET_MS=45000

# Optional. Quota protection for the public /api/scan image path. Demo
# presets and manual entry are never limited, since they cost nothing.
# SCAN_LIMIT_PER_HOUR=10
# SCAN_LIMIT_PER_DAY=30
# SCAN_LIMIT_GLOBAL_PER_DAY=150
# EXTRACTION_CACHE_TTL_MS=21600000

# Optional second vision provider for the AI scan fallback. OpenRouter gives
# access to free vision models, so the scanner keeps working once Gemini's
# daily allowance is gone. Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_1=
# OPENROUTER_API and OPENROUTER_KEY are accepted as aliases.

# Comma-separated, tried in order. Defaults to free vision models confirmed
# present in OpenRouter's catalogue.
# OPENROUTER_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,openrouter/free

# Which providers to try, in order. Defaults to gemini,openrouter.
# VISION_PROVIDER_ORDER=openrouter,gemini

# Ceiling on a single provider attempt, so one stalled provider cannot
# consume the whole budget. Defaults to 18000.
# OCR_ATTEMPT_MS=18000

# Shown to OpenRouter for attribution on its dashboard.
# OPENROUTER_SITE_URL=https://your-app.vercel.app
