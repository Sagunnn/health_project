# Google Gemini API key for label OCR (Vision).
# Free tier: https://aistudio.google.com/apikey
# Without it, presets and manual ingredient entry still work; only camera
# and photo-upload scanning is unavailable.
GEMINI_API_KEY=

# Optional. Overrides the default Gemini model used for extraction.
# Google retires models on a rolling basis; the route falls back through
# gemini-3.5-flash -> gemini-flash-latest -> gemini-3-flash-preview.
# GEMINI_MODEL=gemini-3.5-flash
